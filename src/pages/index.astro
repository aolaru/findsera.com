---
import Layout from "../layouts/Layout.astro";

const title = "Findsera is archived";
const description = "Findsera is an archived product-guide project and is no longer maintained.";
---

<Layout title={title} description={description} canonicalPath="/" robots="noindex, nofollow" adsenseEnabled={false}>
  <section class="section-spacing">
    <div class="container-shell max-w-3xl">
      <span class="eyebrow">Archived project</span>
      <h1 class="mt-6 font-serif text-5xl font-semibold tracking-tight text-ink-900 sm:text-6xl">
        Findsera is no longer being maintained
      </h1>
      <div class="mt-6 space-y-5 text-lg leading-8 text-ink-700">
        <p>
          Product research, pricing, retailer availability, and buying guidance can become outdated quickly. This site
          has been archived rather than continuing to publish information that cannot be actively verified.
        </p>
        <p>
          Advertising, analytics, affiliate activity, automated publishing, and scheduled product maintenance are
          disabled. Existing pages remain available only as an archived project record and should not be used for
          shopping decisions.
        </p>
      </div>
    </div>
  </section>
</Layout>
