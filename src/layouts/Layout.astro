---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  robots?: string;
  adsenseEnabled?: boolean;
  image?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  robots = "index, follow",
  image = "/images/findsera-social-card.svg",
  structuredData
} = Astro.props;

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const hasFileExtension = (pathname: string) => /\.[a-z0-9]+$/i.test(pathname);
const normalizeUrl = (value: string) => {
  const url = new URL(value, siteOrigin);

  if (url.origin === siteOrigin.toString().replace(/\/$/, "") && !hasFileExtension(url.pathname)) {
    url.pathname = url.pathname === "/" ? "/" : `${url.pathname.replace(/\/$/, "")}/`;
  }

  return url.toString();
};

const canonicalUrl = normalizeUrl(canonicalPath);
const socialImageUrl = new URL(image, siteOrigin).toString();
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const archivedSite = true;
const effectiveRobots = archivedSite ? "noindex, nofollow" : robots;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180.png" />
    <meta name="theme-color" content="#e97d2f" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      if (window.location.hostname === "www.findsera.com") {
        window.location.replace(
          `https://findsera.com${window.location.pathname}${window.location.search}${window.location.hash}`
        );
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={effectiveRobots} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Findsera" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {
      !archivedSite && structuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      )
    }
  </head>
  <body class="m-0" data-site-status={archivedSite ? "archived" : "active"}>
    <Header />
    {
      archivedSite && (
        <aside class="border-b border-black/8 bg-sand-50 py-3" aria-label="Site status">
          <div class="container-shell text-sm leading-6 text-ink-700">
            Findsera is archived and is no longer maintained. Retailer links, advertising, analytics, and new content
            publishing are disabled.
          </div>
        </aside>
      )
    }
    <main>
      {
        archivedSite ? (
          <section class="section-spacing">
            <div class="container-shell max-w-3xl">
              <span class="eyebrow">Archived project</span>
              <h1 class="mt-6 font-serif text-5xl font-semibold tracking-tight text-ink-900 sm:text-6xl">
                Findsera is no longer being maintained
              </h1>
              <div class="mt-6 space-y-5 text-lg leading-8 text-ink-700">
                <p>
                  Product research, pricing, retailer availability, and buying guidance can become outdated quickly.
                  This site has been archived rather than continuing to publish information that cannot be actively
                  verified.
                </p>
                <p>
                  Advertising, analytics, affiliate activity, automated publishing, and scheduled product maintenance
                  are disabled. The project is retained only as an archive and should not be used for shopping decisions.
                </p>
              </div>
            </div>
          </section>
        ) : (
          <slot />
        )
      }
    </main>
    <Footer />
  </body>
</html>
