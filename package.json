{
  "name": "findsera.com",
  "description": "Archived Astro starter for a source-driven static catalogue and guide site.",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "keywords": [
    "astro",
    "static-site",
    "content-pipeline",
    "catalogue"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "content:build": "node scripts/generate-content.mjs",
    "content:check": "node scripts/generate-content.mjs",
    "content:import": "node scripts/import-products.mjs",
    "content:refresh": "node scripts/refresh-products.mjs",
    "content:report": "node scripts/report-affiliate-gaps.mjs",
    "content:maintain": "node scripts/daily-maintenance.mjs",
    "content:images": "node scripts/check-product-images.mjs",
    "content:paapi": "node scripts/paapi-refresh-products.mjs",
    "predev": "npm run content:build",
    "prebuild": "npm run content:build",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.7",
    "tailwindcss": "^4.2.2"
  }
}
